# Copy this to .env for local testing — on Railway/Render, set these as
# actual environment variables in their dashboard instead of a file.

# Same bot token already set in the Vercel app's DISCORD_BOT_TOKEN.
DISCORD_BOT_TOKEN=

# A secret you make up — long, random, unguessable. This protects the
# /send-dm endpoint so nobody else can trigger DMs from your bot.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value also goes into the Vercel app as a new env var so it
# can call this service.
API_SECRET=

# Railway/Render set this automatically — only needed for local testing.
PORT=3000
